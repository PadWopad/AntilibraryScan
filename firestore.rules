rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: signals
    // Fields: title (string), summary (string), source (string), timestamp (string), tags (list), temporalWindows (list), embedding (list), fileUrl (string), authorUid (string)
    //
    // Collection: weakSignals
    // Fields: content (string), score (number), timestamp (string)
    //
    // Collection: userSources/{uid}/{sourceId}
    // Fields: name (string), type (string), url (string), active (bool)
    //
    // Collection: botUsers
    // Fields: chatId (string), userId (string), username (string)
    //
    // Collection: systemState
    // Fields: escalation (number), destab (number), attentionSpike (number), lastUpdated (string)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "mikle339900@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    function isValidSignal(data) {
      let allowedFields = ['title', 'summary', 'source', 'timestamp', 'tags', 'temporalWindows', 'embedding', 'fileUrl', 'authorUid', 'processedFrom', 'status'];
      return data.keys().hasAll(['title', 'summary', 'source', 'timestamp']) &&
             hasOnlyAllowedFields(allowedFields) &&
             validStringLength('title', 1, 500) &&
             validStringLength('summary', 1, 10000) &&
             data.source is string &&
             data.timestamp is string;
    }

    function isValidUserSource(data) {
      let allowedFields = ['name', 'type', 'url', 'active'];
      return data.keys().hasAll(['name', 'type', 'url', 'active']) &&
             hasOnlyAllowedFields(allowedFields) &&
             validStringLength('name', 1, 200) &&
             data.type in ['rss', 'telegram', 'reddit'] &&
             data.url is string &&
             data.active is bool;
    }

    function isValidTheory(data) {
      let allowedFields = ['id', 'title', 'thesis', 'observations', 'connections', 'persuasionIndex', 'artisticPower', 'counterArgument', 'criticalAnalysis', 'prediction', 'category', 'status', 'version', 'parentTheoryId', 'oracleScore', 'lastUpdated', 'authorUid'];
      return data.keys().hasAll(['id', 'title', 'thesis', 'observations', 'connections', 'persuasionIndex', 'artisticPower', 'counterArgument', 'criticalAnalysis', 'prediction', 'category', 'status', 'version', 'lastUpdated']) &&
             hasOnlyAllowedFields(allowedFields) &&
             data.id is string &&
             validStringLength('title', 1, 1000) &&
             validStringLength('thesis', 1, 10000) &&
             data.observations is list &&
             data.connections is list &&
             data.persuasionIndex is int &&
             data.artisticPower is int &&
             data.category in ["синхронизация", "символизм", "напряжение", "география", "алгоритмика", "история"] &&
             data.status in ["Черновик", "Активно", "Подтверждено", "Опровергнуто"] &&
             data.version is int &&
             data.lastUpdated is int;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /signals/{signalId} {
      allow read: if true; // Public read for dashboard visibility
      allow create: if isAuthenticated() && isValidSignal(request.resource.data) && 
                    (request.resource.data.authorUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /weakSignals/{weakSignalId} {
      allow read: if true; // Public read for dashboard visibility
      allow create: if isAuthenticated(); // Usually created by background processes/admins
      allow update, delete: if isAdmin();
    }

    match /userSources/{uid}/{sourceId} {
      allow read, write: if isOwner(uid) && isValidUserSource(request.resource.data);
    }

    match /botUsers/{chatId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == request.resource.data.userId || isAdmin());
    }

    match /systemState/{stateId} {
      allow read: if true; // Public read for dashboard visibility
      allow write: if isAdmin();
    }

    match /theories/{theoryId} {
      allow read: if true; // Public read for dashboard visibility
      allow create: if isAuthenticated() && isValidTheory(request.resource.data) && 
                    (request.resource.data.authorUid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && isValidTheory(request.resource.data) && 
                    (request.resource.data.authorUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
